<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3>Data Reservasi</h3>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTambah">+ Buat Reservasi</button>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>ID</th>
          <th>Pelanggan</th>
          <th>Pegawai PIC</th>
          <th>Tanggal Reservasi</th>
          <th>Status</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(item => { %>
        <tr>
          <td>#<%= item.reservasi_id %></td>
          <td><%= item.nama_pelanggan %></td>
          <td><%= item.nama_pegawai %></td>
          <td><%= new Date(item.tanggal_reservasi).toLocaleDateString('id-ID') %></td>
          <td><span class="badge bg-secondary"><%= item.status_reservasi %></span></td>
          <td>
            <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#modalEdit<%= item.reservasi_id %>">Edit</button>
            <form action="/reservasi/hapus/<%= item.reservasi_id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus reservasi ini? Jadwal terkait juga akan terhapus.')">
              <button class="btn btn-sm btn-danger">Hapus</button>
            </form>
          </td>
        </tr>

        <div class="modal fade" id="modalEdit<%= item.reservasi_id %>" tabindex="-1">
          <div class="modal-dialog">
            <form action="/reservasi/edit/<%= item.reservasi_id %>" method="POST" class="modal-content">
              <div class="modal-header"><h5 class="modal-title">Edit Reservasi #<%= item.reservasi_id %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
              <div class="modal-body">
                <div class="mb-2">
                  <label>Pelanggan</label>
                  <select name="pelanggan_id" class="form-select" required>
                    <% pelangganList.forEach(p => { %>
                      <option value="<%= p.pelanggan_id %>" <%= p.pelanggan_id === item.pelanggan_id ? 'selected' : '' %>><%= p.nama_lengkap %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-2">
                  <label>Pegawai</label>
                  <select name="pegawai_id" class="form-select" required>
                    <% pegawaiList.forEach(pg => { %>
                      <option value="<%= pg.pegawai_id %>" <%= pg.pegawai_id === item.pegawai_id ? 'selected' : '' %>><%= pg.nama_pegawai %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-2">
                  <label>Tanggal Reservasi</label>
                  <input type="date" name="tanggal_reservasi" class="form-control" value="<%= new Date(item.tanggal_reservasi).toISOString().split('T')[0] %>" required>
                </div>
                <div class="mb-2">
                  <label>Status Reservasi</label>
                  <select name="status_reservasi" class="form-select">
                    <% ['Pending', 'Dikonfirmasi', 'Selesai', 'Dibatalkan'].forEach(st => { %>
                      <option value="<%= st %>" <%= item.status_reservasi === st ? 'selected' : '' %>><%= st %></option>
                    <% }) %>
                  </select>
                </div>
              </div>
              <div class="modal-footer"><button type="submit" class="btn btn-primary">Simpan</button></div>
            </form>
          </div>
        </div>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="modalTambah" tabindex="-1">
  <div class="modal-dialog">
    <form action="/reservasi/tambah" method="POST" class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Buat Reservasi</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-2">
          <label>Pelanggan</label>
          <select name="pelanggan_id" class="form-select" required>
            <% pelangganList.forEach(p => { %>
              <option value="<%= p.pelanggan_id %>"><%= p.nama_lengkap %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-2">
          <label>Pegawai</label>
          <select name="pegawai_id" class="form-select" required>
            <% pegawaiList.forEach(pg => { %>
              <option value="<%= pg.pegawai_id %>"><%= pg.nama_pegawai %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-2">
          <label>Tanggal Reservasi</label>
          <input type="date" name="tanggal_reservasi" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
        </div>
        <div class="mb-2">
          <label>Status Reservasi</label>
          <select name="status_reservasi" class="form-select">
            <option value="Pending">Pending</option>
            <option value="Dikonfirmasi">Dikonfirmasi</option>
            <option value="Selesai">Selesai</option>
            <option value="Dibatalkan">Dibatalkan</option>
          </select>
        </div>
      </div>
      <div class="modal-footer"><button type="submit" class="btn btn-primary">Simpan</button></div>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
