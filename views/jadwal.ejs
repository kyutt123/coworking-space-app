<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3>Data Jadwal Penggunaan Ruangan</h3>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTambah">+ Tambah Jadwal</button>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>ID</th>
          <th>Reservasi</th>
          <th>Ruangan</th>
          <th>Waktu Mulai</th>
          <th>Waktu Selesai</th>
          <th>Durasi & Estimasi</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(item => { %>
        <tr>
          <td><%= item.jadwal_id %></td>
          <td>#<%= item.reservasi_id %> - <%= item.nama_pelanggan %></td>
          <td><%= item.nama_ruangan %></td>
          <td><%= new Date(item.waktu_mulai).toLocaleString('id-ID') %></td>
          <td><%= new Date(item.waktu_selesai).toLocaleString('id-ID') %></td>
          <td>
            <%= item.durasi_jam %> jam<br>
            <small class="text-muted">Rp <%= Math.round(item.durasi_jam * item.harga_per_jam).toLocaleString('id-ID') %></small>
          </td>
          <td>
            <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#modalEdit<%= item.jadwal_id %>">Edit</button>
            <form action="/jadwal/hapus/<%= item.jadwal_id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus jadwal ini?')">
              <button class="btn btn-sm btn-danger">Hapus</button>
            </form>
          </td>
        </tr>

        <div class="modal fade" id="modalEdit<%= item.jadwal_id %>" tabindex="-1">
          <div class="modal-dialog">
            <form action="/jadwal/edit/<%= item.jadwal_id %>" method="POST" class="modal-content">
              <div class="modal-header"><h5 class="modal-title">Edit Jadwal</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
              <div class="modal-body">
                <div class="mb-2">
                  <label>ID Reservasi</label>
                  <select name="reservasi_id" class="form-select" required>
                    <% reservasiList.forEach(r => { %>
                      <option value="<%= r.reservasi_id %>" <%= r.reservasi_id === item.reservasi_id ? 'selected' : '' %>>#<%= r.reservasi_id %> - <%= r.nama_lengkap %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-2">
                  <label>Ruangan</label>
                  <select name="ruangan_id" class="form-select" required>
                    <% ruanganList.forEach(ru => { %>
                      <option value="<%= ru.ruangan_id %>" <%= ru.ruangan_id === item.ruangan_id ? 'selected' : '' %>><%= ru.nama_ruangan %> (Rp <%= ru.harga_per_jam %>/jam)</option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-2">
                  <label>Waktu Mulai</label>
                  <input type="datetime-local" name="waktu_mulai" class="form-control" value="<%= new Date(new Date(item.waktu_mulai).getTime() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0,16) %>" required>
                </div>
                <div class="mb-2">
                  <label>Waktu Selesai</label>
                  <input type="datetime-local" name="waktu_selesai" class="form-control" value="<%= new Date(new Date(item.waktu_selesai).getTime() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0,16) %>" required>
                </div>
              </div>
              <div class="modal-footer"><button type="submit" class="btn btn-primary">Simpan</button></div>
            </form>
          </div>
        </div>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="modalTambah" tabindex="-1">
  <div class="modal-dialog">
    <form action="/jadwal/tambah" method="POST" class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Tambah Jadwal</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-2">
          <label>Reservasi</label>
          <select name="reservasi_id" class="form-select" required>
            <% reservasiList.forEach(r => { %>
              <option value="<%= r.reservasi_id %>">#<%= r.reservasi_id %> - <%= r.nama_lengkap %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-2">
          <label>Ruangan (Status Tersedia)</label>
          <select name="ruangan_id" class="form-select" required>
            <% ruanganList.forEach(ru => { %>
              <option value="<%= ru.ruangan_id %>"><%= ru.nama_ruangan %> (Rp <%= ru.harga_per_jam %>/jam)</option>
            <% }) %>
          </select>
        </div>
        <div class="mb-2"><label>Waktu Mulai</label><input type="datetime-local" name="waktu_mulai" class="form-control" required></div>
        <div class="mb-2"><label>Waktu Selesai</label><input type="datetime-local" name="waktu_selesai" class="form-control" required></div>
      </div>
      <div class="modal-footer"><button type="submit" class="btn btn-primary">Simpan</button></div>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
